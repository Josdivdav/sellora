# -------------------------------------------------------------
# Sellora Marketplace — Environment Configuration Template
# Copy this file to .env.local for local development.
# -------------------------------------------------------------

# 1. Firebase Admin SDK Service Account (Required for database & auth)
PROJECT_ID=sellora-fe391
CLIENT_EMAIL=firebase-adminsdk-xxxxx@sellora-fe391.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 2. Site Domains & URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_DOMAIN=localhost:3000

# 3. Gmail SMTP Email Notifications (Required for automated customer & merchant emails)
# How to get GMAIL_APP_PASSWORD:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Select 'Mail' and create a 16-character password (e.g. "abcd efgh ijkl mnop")
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your16charpassword
GMAIL_FROM="Sellora Marketplace <your-email@gmail.com>"

# 4. Store Default Direct Bank Transfer Details
NEXT_PUBLIC_STORE_BANK_NAME=OPay
NEXT_PUBLIC_STORE_ACCOUNT_NUMBER=8038737198
NEXT_PUBLIC_STORE_ACCOUNT_NAME="Sellora Direct Account"

# 5. Customer Care / WhatsApp Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=2348038737198

# 6. Developer Console & Platform Administration
DEVELOPER_PASSCODE=your_developer_passcode_here
ADMIN_EMAIL=your-email@gmail.com
